# ───────────────────────────────────────────────────────────────────────────
# Gazetka Górka — przykładowa konfiguracja sekretów.
# Skopiuj ten plik do `.env` i uzupełnij. Plik `.env` jest w .gitignore
# i NIGDY nie trafia do repozytorium.
# ───────────────────────────────────────────────────────────────────────────

# Hash hasła administratora (bcrypt). NIGDY nie wpisuj hasła w plaintext!
# Wygeneruj hash poleceniem:  npm run hash-password
ADMIN_PASSWORD_HASH=

# Sekret do podpisywania tokenów sesji panelu admina.
# Wygeneruj np.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Port serwera panelu administratora (dostęp po LAN). Domyślnie 8137.
ADMIN_PORT=8137

# Adres nasłuchu serwera admina. 0.0.0.0 = dostępny w całej sieci LAN.
# Ustaw 127.0.0.1 aby ograniczyć dostęp tylko do tego komputera.
ADMIN_HOST=0.0.0.0
